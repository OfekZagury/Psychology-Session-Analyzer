# Copy to .env and fill in the API keys. Never commit .env.

# --- Infrastructure (local development credentials) ---
RABBITMQ_DEFAULT_USER=therapy
RABBITMQ_DEFAULT_PASS=change-me
MINIO_ROOT_USER=therapy
MINIO_ROOT_PASSWORD=change-me-too

# --- External APIs ---
ASSEMBLYAI_API_KEY=your-assemblyai-key
OPENAI_API_KEY=your-openai-key

# --- Optional settings ---
# Language of the session audio (AssemblyAI language code)
TRANSCRIPTION_LANGUAGE=en
# Any OpenAI chat model that supports JSON mode
OPENAI_MODEL=gpt-4o-mini

# --- Optional monitoring (only with: docker compose --profile monitoring up) ---
DD_API_KEY=
DD_SITE=datadoghq.eu
